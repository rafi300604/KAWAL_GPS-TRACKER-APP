# Copy file ini jadi .env lalu isi nilainya. JANGAN commit .env ke git.

# --- PostgreSQL -------------------------------------------------
# User superuser Postgres -- dipakai healthcheck & yang buat database.
POSTGRES_USER=postgres

# Password Postgres
POSTGRES_PASSWORD=ganti_dengan_password_kuat

# Nama database aplikasi
POSTGRES_DB=telemetry_gps

# Shared API key untuk SEMUA device di fleet (device kirim ini di header
# X-API-Key). Identitas device sendiri datang dari field "sn" di body,
# bukan dari key ini. Generate dengan:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_API_KEY=ganti_dengan_random_key

# Admin key -- dipakai untuk baca data (GET /devices, /telemetry/*).
# Generate dengan cara yang sama seperti di atas.
ADMIN_API_KEY=ganti_dengan_random_key_lain

# Domain untuk HTTPS otomatis lewat Caddy. Pastikan DNS A record
# subdomain ini sudah diarahkan ke IP VPS SEBELUM docker compose up,
# supaya Caddy berhasil verifikasi & terbitkan sertifikat Let's Encrypt.
DOMAIN=gps.jejakpintar.cloud
