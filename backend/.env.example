# Copy file ini jadi .env lalu isi nilainya. JANGAN commit .env ke git.

# --- PostgreSQL -------------------------------------------------
# User superuser Postgres -- dipakai healthcheck & yang buat database.
POSTGRES_USER=kawal_gps_user

# Password Postgres
POSTGRES_PASSWORD=ganti_dengan_password_kuat

# Nama database aplikasi
POSTGRES_DB=kawal_gps_db

# Shared API key untuk SEMUA device di fleet (device kirim ini di header
# X-API-Key). Identitas device sendiri datang dari field "sn" di body,
# bukan dari key ini. Generate dengan:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_API_KEY=ganti_dengan_random_key

# Admin key -- dipakai untuk baca data (GET /devices, /telemetry/*).
# Generate dengan cara yang sama seperti di atas.
ADMIN_API_KEY=ganti_dengan_random_key_lain

# Secret buat menandatangani JWT login pengguna (POST /auth/login, dst).
# BEDA dari DEVICE_API_KEY/ADMIN_API_KEY di atas -- itu shared secret statis,
# ini kunci HMAC buat token per-user. Generate dengan cara yang sama:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=ganti_dengan_random_key_lagi

# Domain untuk HTTPS otomatis lewat reverse proxy (Caddy / Nginx). Pastikan DNS A record
# subdomain ini sudah diarahkan ke IP VPS SEBELUM deploy.
DOMAIN=gps.kawalgps.com

# --- MQTT (jalur GSM/seluler hemat kuota) -------------------------------
# Backend sendiri konek ke listener broker.
# Jika menggunakan broker internal stack:
#   GPS_MQTT_BROKER=mqtt, GPS_MQTT_INTERNAL_PORT=1883
# Jika nebeng broker VPS yang sudah ada:
#   GPS_MQTT_BROKER=host.docker.internal, GPS_MQTT_INTERNAL_PORT=1883
GPS_MQTT_BROKER=mqtt
GPS_MQTT_INTERNAL_PORT=1883
GPS_MQTT_CLIENT_ID=kawal-gps-backend-sub
